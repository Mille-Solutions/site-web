---
/**
 * Premier écran des pages de phase 2.
 * - layout « stacked » : texte puis grande image (Accompagnements, Exemples) ;
 * - layout « split » : texte à gauche, image à droite (Approche et parcours).
 */
import ExternalLink from '../ExternalLink.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  /** Titre découpé en lignes (prioritaire sur `title`). */
  titleLines?: string[];
  lead: string;
  primary?: string;
  secondary?: { label: string; href: string };
  bookingsUrl: string;
  imageCaption: string;
  /** Photo du premier écran ; à défaut, un emplacement réservé est affiché. */
  image?: ImageMetadata;
  imageAlt?: string;
  layout?: 'stacked' | 'split';
  track: string;
}
const { lang, title, titleLines, lead, primary, secondary, bookingsUrl, imageCaption, image, imageAlt = '', layout = 'stacked', track } = Astro.props;
const split = layout === 'split';
---

<section class="bg-ivory py-14 lg:py-24">
  <div class:list={['container-site', split && 'grid items-center gap-10 lg:min-h-[43rem] lg:grid-cols-[35rem_1fr] lg:gap-0']}>
    <div class:list={['flex min-w-0 flex-col gap-8', split ? 'lg:max-w-[33rem]' : 'max-w-[53rem]']}>
      <slot name="before" />
      <h1 class:list={['font-semibold tracking-[-0.015em]', split ? 'text-[2.5rem] leading-[1.1] lg:text-[4.5rem] lg:leading-[1.05]' : 'text-[2.5rem] leading-[1.2] text-balance lg:text-5xl']}>
        {titleLines ? titleLines.map((line) => <span class="block">{line}</span>) : title}
      </h1>
      <p class:list={['text-stone', split ? 'text-lg leading-[1.6]' : 'leading-6']}>{lead}</p>
      <slot />
      {
        (primary || secondary) && (
          <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center">
            {primary && (
              <ExternalLink href={bookingsUrl} lang={lang} icon={false} track={track} class="btn btn-dark">
                {primary}
              </ExternalLink>
            )}
            {secondary && (
              <a href={secondary.href} class="btn btn-secondary">
                {secondary.label}
              </a>
            )}
          </div>
        )
      }
    </div>
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt}
          width={1920}
          widths={[640, 1280, 1920]}
          sizes="(min-width: 1440px) 1280px, calc(100vw - 3rem)"
          loading="eager"
          fetchpriority="high"
          class:list={[split ? 'aspect-[342/320] w-full object-cover lg:aspect-auto lg:h-full' : 'mt-8 aspect-[342/240] w-full object-cover lg:mt-16 lg:aspect-[1280/520]']}
        />
      ) : (
        <PhotoPlaceholder
          caption={imageCaption}
          class:list={[split ? 'aspect-[342/320] w-full lg:aspect-[720/688]' : 'mt-8 aspect-[342/240] w-full lg:mt-16 lg:aspect-[1280/520]']}
        />
      )
    }
  </div>
</section>
