---
/** Lien externe ouvert dans un nouvel onglet, annoncé aux lecteurs d'écran. */
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  lang: Lang;
  icon?: boolean;
  track?: string;
}
const { href, lang, icon = true, track, class: className, ...rest } = Astro.props;
---

<a href={href} target="_blank" rel="noopener" class={className} data-track={track} {...rest}>
  <slot />
  <span class="sr-only">{ui[lang].newTab}</span>
  {icon && <Icon name="external" class="size-4 shrink-0" />}
</a>
