---
import type { CollectionEntry } from 'astro:content';
import ExternalLink from '../ExternalLink.astro';
import ContactForm from './ContactForm.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  content: CollectionEntry<'home'>['data']['contact'];
  id: string;
  bookingsUrl: string;
  formEndpoint: string;
}
const { lang, content, id, bookingsUrl, formEndpoint } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="section bg-white">
  <div class="container-site">
    <h2 id={`${id}-title`} class="text-[2.5rem] leading-[1.2] font-semibold text-balance lg:text-[4.5rem]">{content.title}</h2>
    <p class="mt-6 max-w-[53rem] text-lg leading-[1.6] text-stone lg:mt-6">{content.text}</p>

    <div class="mt-8 grid items-start gap-6 lg:mt-16 lg:grid-cols-[515fr_733fr] lg:gap-8">
      <div class="card flex flex-col gap-6 lg:sticky lg:top-32">
        <div class="flex flex-col gap-4">
          <p class="eyebrow">{content.booking.eyebrow}</p>
          <p class="text-lg leading-[1.45]">{content.booking.text}</p>
        </div>
        <ExternalLink href={bookingsUrl} lang={lang} icon={false} track="contact" class="btn btn-primary w-full">
          {content.booking.cta}
        </ExternalLink>
      </div>

      <ContactForm lang={lang} content={content.form} endpoint={formEndpoint} />
    </div>
  </div>
</section>
