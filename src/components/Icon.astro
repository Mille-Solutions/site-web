---
/** Icônes de la charte : trait 1,5 px, angles arrondis, pas de remplissage. */
interface Props {
  name: 'project' | 'simplify' | 'unblock' | 'arrow' | 'external' | 'menu' | 'close' | 'linkedin';
  class?: string;
}
const { name, class: className = 'size-6' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'project' && (
      <>
        <circle cx="4.5" cy="18.5" r="2" />
        <path d="M6.5 18.5h5a3 3 0 0 0 0-6h-1a3 3 0 0 1 0-6h7" />
        <path d="M17.5 3.5v6" />
        <path d="M17.5 3.5h3l-1 1.5 1 1.5h-3" />
      </>
    )
  }
  {
    name === 'simplify' && (
      <>
        <rect x="3.5" y="3.5" width="7" height="7" rx="1.5" />
        <rect x="13.5" y="3.5" width="7" height="7" rx="1.5" />
        <rect x="3.5" y="13.5" width="7" height="7" rx="1.5" />
        <rect x="13.5" y="13.5" width="7" height="7" rx="1.5" />
      </>
    )
  }
  {
    name === 'unblock' && (
      <>
        <circle cx="5" cy="12" r="2" />
        <path d="M7 12h3.5c2 0 2.5-6 6.5-6h2" />
        <path d="M10.5 12c2 0 2.5 6 6.5 6h2" />
        <path d="M17.5 4.5 19 6l-1.5 1.5" />
        <path d="M17.5 16.5 19 18l-1.5 1.5" />
      </>
    )
  }
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {
    name === 'external' && (
      <>
        <path d="M14 4h6v6" />
        <path d="M20 4 11 13" />
        <path d="M18 14v4.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10" />
      </>
    )
  }
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {
    name === 'linkedin' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="2.5" />
        <path d="M8 10.5v6M8 7.5v.01M11.5 16.5v-6M11.5 13c0-1.5 1-2.5 2.5-2.5s2.5 1 2.5 2.5v3.5" />
      </>
    )
  }
</svg>
