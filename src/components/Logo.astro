---
/**
 * Logotype Mille Solutions (charte 2026).
 * « Mille » : Playfair Display SemiBold 600 ; « Solutions » : Inter Light 300, à 61 % de la taille de « Mille ».
 * Les deux mots restent sur une ligne. Le filet Azure est optionnel, indépendant, espacé d'au moins 12 px.
 */
interface Props {
  /** Taille de « Mille » en pixels. */
  size?: number;
  accent?: boolean;
  class?: string;
}
const { size = 26, accent = false, class: className = '' } = Astro.props;
---

<span class:list={['inline-flex flex-col items-start text-navy', className]} style={`--logo:${size}px`}>
  <span class="inline-flex items-baseline gap-[calc(var(--logo)*0.13)] leading-[1.15] whitespace-nowrap">
    <span class="font-wordmark text-[length:var(--logo)] font-semibold">Mille</span>
    <span class="text-[length:calc(var(--logo)*0.61)] font-light">Solutions</span>
  </span>
  {accent && <span aria-hidden="true" class="mt-3 block h-px w-[calc(var(--logo)*3.3)] bg-azur"></span>}
</span>
