---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
import ExternalLink from '../ExternalLink.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  content: CollectionEntry<'home'>['data']['about'];
  id: string;
  linkedinUrl: string;
}
const { lang, content, id, linkedinUrl } = Astro.props;
const [first, ...rest] = content.paragraphs;
---

<section id={id} aria-labelledby={`${id}-title`} class="section bg-ivory">
  <div class="container-site">
    <SectionHeading eyebrow={content.eyebrow} title={content.title} id={`${id}-title`} />
    <div class="mt-8 grid gap-8 lg:mt-16 lg:grid-cols-[22.5rem_1fr] lg:gap-8">
      <PhotoPlaceholder caption={content.portraitCaption} class="reveal aspect-[342/380] w-full lg:aspect-[3/4]" />
      <div class="flex flex-col items-start gap-6">
        <p class="text-2xl leading-[1.45] font-medium lg:text-[1.75rem] lg:leading-[1.35]">{first}</p>
        {rest.map((p) => <p class="text-lg leading-[1.6] text-stone">{p}</p>)}
        <!-- Phase 1 : LinkedIn ; phase 2 : page « Approche et parcours » -->
        <ExternalLink href={linkedinUrl} lang={lang} icon={false} class="btn btn-secondary w-full sm:w-auto">
          {content.cta}
        </ExternalLink>
      </div>
    </div>
  </div>
</section>
