---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { Lang } from '../../i18n/ui';
// Photo provisoire reprise de la maquette Figma (« hero-image ») : origine et droits à valider.
import heroImage from '../../assets/hero-charlotte.jpeg';

interface Props {
  lang: Lang;
  content: CollectionEntry<'home'>['data']['hero'];
}
const { content } = Astro.props;
---

<section class="bg-ivory pt-14 pb-8 sm:pb-14 lg:py-24">
  <div class="container-site">
    <div class="flex max-w-[53rem] flex-col gap-8">
      <h1 class="text-[2rem] leading-[1.25] font-semibold sm:text-5xl sm:leading-[1.1] sm:tracking-[-0.015em] lg:text-[4rem] lg:leading-[1.05]">
        {content.title.map((line) => <span class="block">{line}</span>)}
      </h1>
      <div class="flex flex-col gap-4">
        <p class="leading-6 text-stone sm:text-lg sm:leading-[1.6] lg:text-xl">{content.lead}</p>
        {content.leadSecondary && <p class="leading-6 text-stone sm:text-lg sm:leading-[1.6] lg:text-xl">{content.leadSecondary}</p>}
      </div>

      {content.engagementLabel || content.signature && (
        <div class="flex flex-col gap-3">
          {content.engagementLabel && <p class="eyebrow">{content.engagementLabel}</p>}
          <p class="text-xl leading-[1.3] font-medium sm:text-2xl sm:leading-[1.2] sm:font-semibold lg:text-[2rem]">{content.signature}</p>
        </div>
      )}

    </div>

    <Image
      src={heroImage}
      alt={content.imageAlt}
      widths={[640, 1024]}
      sizes="(min-width: 1440px) 1280px, calc(100vw - 3rem)"
      loading="eager"
      fetchpriority="high"
      class="mt-8 aspect-[342/240] w-full rounded-(--radius-card) object-cover object-[50%_18%] lg:mt-14 lg:aspect-[1280/520]"
    />
  </div>
</section>
