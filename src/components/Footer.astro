---
import { getEntry } from 'astro:content';
import Logo from './Logo.astro';
import { ui, routes, navItems, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const settings = (await getEntry('settings', 'links'))!.data;
const items = navItems(lang, settings.phase2Enabled);
---

<footer class="bg-ivory">
  <div class="container-site flex flex-col gap-10 pt-16 pb-8 sm:gap-12 sm:pb-10 lg:gap-16 lg:pt-24">
    <div class="h-px bg-azur" aria-hidden="true"></div>

    <div class="flex flex-col gap-8 sm:gap-12 lg:flex-row lg:justify-between">
      <div class="flex flex-col gap-5 sm:gap-6">
        <Logo size={24} />
        <p class="text-sm leading-[1.6] text-stone">{t.signature}</p>
      </div>

      <div class="flex flex-col gap-8 text-sm sm:flex-row sm:gap-20">
        <nav aria-labelledby="footer-nav">
          <p id="footer-nav" class="font-semibold">{t.footerNav}</p>
          <!-- Mobile : cibles tactiles de 44 px (maquette « Accueil mobile — FR ») -->
          <ul class="mt-1 space-y-1 text-stone sm:mt-3">
            {
              items.map((item) => (
                <li>
                  <a href={item.href} class="inline-flex min-h-11 items-center hover:text-navy hover:underline sm:min-h-8">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div>
          <p class="font-semibold">{t.footerContact}</p>
          <address class="mt-3 leading-[1.6] text-stone not-italic sm:mt-5">
            {t.footerContactLines.map((line) => <p>{line}</p>)}
          </address>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-5 text-xs text-stone sm:flex-row sm:items-center sm:justify-between sm:gap-4">
      <p class="uppercase">© {new Date().getFullYear()} Mille Solutions. {t.rights}</p>
      <nav aria-label={t.legalNav}>
        <ul class="flex gap-6 text-sm text-navy sm:text-xs sm:text-stone">
          <li><a href={routes.legal[lang]} class="inline-flex min-h-11 items-center hover:text-navy hover:underline sm:min-h-8">{t.legal}</a></li>
          <li><a href={routes.privacy[lang]} class="inline-flex min-h-11 items-center hover:text-navy hover:underline sm:min-h-8">{t.privacy}</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
