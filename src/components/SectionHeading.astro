---
/** En-tête de section façon charte : numéro, sur-titre en capitales, titre et filet. */
interface Props {
  number: string;
  eyebrow: string;
  title: string;
  id?: string;
  tone?: 'navy' | 'ivory';
}
const { number, eyebrow, title, id, tone = 'navy' } = Astro.props;
---

<div class="mb-10 sm:mb-14">
  <p class:list={['eyebrow', tone === 'ivory' ? 'text-ivory/70' : 'text-stone']}>
    <span class={tone === 'ivory' ? 'text-ivory' : 'text-navy'}>{number}</span>
    <span>{eyebrow}</span>
  </p>
  <h2 id={id} class="mt-4 max-w-3xl text-3xl font-semibold tracking-[-0.01em] text-balance sm:text-4xl">{title}</h2>
  <span aria-hidden="true" class="mt-6 block h-px w-14 bg-azur"></span>
</div>
