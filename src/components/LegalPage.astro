---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  route: 'legal' | 'privacy';
  /** Identifiant du fichier Markdown, ex. « fr/mentions-legales ». */
  entry: string;
}
const { lang, route, entry } = Astro.props;
const page = (await getEntry('legal', entry))!;
const { Content, headings } = await render(page);
const toc = headings.filter((h) => h.depth === 2);
const t = ui[lang];
---

<Base lang={lang} route={route} title={`${page.data.title} | Mille Solutions`} description={page.data.description} noindex={page.data.draft}>
  <!-- En-tête juridique (maquette « Mentions légales — brouillon non publiable ») -->
  <header class="pt-14 pb-10 lg:pt-20 lg:pb-12">
    <div class="container-site flex flex-col gap-6">
      <p class="eyebrow leading-[1.4]">{t.legalEyebrow}</p>
      <h1 class="text-[2.5rem] leading-[1.2] font-semibold lg:text-5xl lg:leading-[3.625rem]">{page.data.title}</h1>
      <p class="text-stone">
        {t.updated} : {page.data.updated}{page.data.draft && <> · {t.draftStatus}</>}
      </p>
      {page.data.draft && <p class="border-l-3 border-azur bg-azur-mist p-6">{t.draftWarning}</p>}
    </div>
  </header>

  <div class="container-site grid gap-10 pb-20 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-20">
    {
      toc.length > 1 && (
        <nav aria-labelledby="toc-title" class="lg:sticky lg:top-32 lg:self-start lg:pt-6">
          <h2 id="toc-title" class="eyebrow leading-[1.4]">{t.toc}</h2>
          <ol class="mt-3 flex flex-col gap-3.5 text-[0.9375rem] leading-normal lg:mt-4">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="inline-flex min-h-8 items-center text-navy hover:underline hover:decoration-azur hover:underline-offset-4">
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <article class="prose-legal min-w-0">
      <Content />
    </article>
  </div>
</Base>
