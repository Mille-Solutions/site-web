---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  content: CollectionEntry<'home'>['data']['examples'];
  id: string;
}
const { content, id } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="py-20 sm:py-28">
  <div class="container-site">
    <SectionHeading number="04." eyebrow={content.eyebrow} title={content.title} id={`${id}-title`} />
    <ul class="grid gap-6 md:grid-cols-3">
      {
        content.items.map((item) => (
          <li class="reveal card flex flex-col p-7">
            <p class="text-sm text-stone">
              <span class="sr-only">{content.durationLabel} : </span>
              {item.duration}
            </p>
            <span aria-hidden="true" class="mt-4 block h-px w-8 bg-azur" />
            <h3 class="mt-5 text-xl font-semibold">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-stone">{item.summary}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 text-sm text-stone">{content.note}</p>
  </div>
</section>
