---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from './home/Hero.astro';
import CardSection from './home/CardSection.astro';
import About from './home/About.astro';
import Contact from './home/Contact.astro';
import { contactEndpoint, routes, sections, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const content = (await getEntry('home', lang))!.data;
const settings = (await getEntry('settings', 'links'))!.data;
const s = sections[lang];
const { situations, method, examples } = content;
// Le bouton du bandeau Contact mène à la page Contact dès que le service d'envoi est configuré ;
// en attendant, il renvoie vers le formulaire Microsoft Forms.
const formReady = contactEndpoint(settings.contactFormEndpoint) !== '';
const formHref = formReady || !settings.contactFormsUrl ? routes.contact[lang] : settings.contactFormsUrl;
---

<Base lang={lang} route="home" title={content.meta.title} description={content.meta.description}>
  <Hero lang={lang} content={content.hero} />
  <CardSection id={s.situations} eyebrow={situations.eyebrow} title={situations.title} items={situations.items} />
  <CardSection id={s.approach} eyebrow={method.eyebrow} title={method.title} items={method.steps} note={method.note} ordered />
  <CardSection
    id={s.examples}
    eyebrow={examples.eyebrow}
    title={examples.title}
    items={examples.items.map((item) => ({ ...item, icon: 'solutions' as const }))}
    note={examples.note}
  />
  <About lang={lang} content={content.about} id={s.about} linkedinUrl={settings.linkedinUrl} />
  <Contact lang={lang} content={content.contact} id={s.contact} formHref={formHref} formExternal={formHref === settings.contactFormsUrl} tone="dark" />
</Base>
