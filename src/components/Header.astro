---
import { getEntry } from 'astro:content';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import ExternalLink from './ExternalLink.astro';
import LangSwitch from './LangSwitch.astro';
import { ui, routes, navItems, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  route: RouteKey;
}
const { lang, route } = Astro.props;
const t = ui[lang];
const home = routes.home[lang];
const settings = (await getEntry('settings', 'links'))!.data;

const items = navItems(lang, settings.phase2Enabled);
// Page active (pages de phase 2 uniquement : sur l'accueil, le menu renvoie à des sections).
const isCurrent = (key: RouteKey) => key === route && key !== 'home';
---

<header class="sticky top-0 z-40 border-b border-azur bg-ivory">
  <div class="container-site flex h-[5.5rem] items-center justify-between gap-6">
    <div class="flex items-center gap-4 sm:gap-6">
      <a href={home} aria-label={t.logoHome} class="shrink-0">
        <Logo size={24} />
      </a>
      <LangSwitch lang={lang} route={route} enabled={settings.englishEnabled} />
    </div>

    <nav aria-label={t.mainNav} class="hidden xl:block">
      <ul class="flex items-center gap-8 text-sm text-stone">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.key) ? 'page' : undefined}
                class:list={['py-3 hover:text-navy', isCurrent(item.key) && 'font-semibold text-navy']}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <ExternalLink href={settings.bookingsUrl} lang={lang} icon={false} track="header" class="btn btn-primary">
            {t.book}
          </ExternalLink>
        </li>
      </ul>
    </nav>

    <button
      type="button"
      class="-mr-2 inline-flex min-h-11 items-center gap-2 px-2 text-sm font-medium xl:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
      data-labels={JSON.stringify({ open: t.menuOpen, close: t.menuClose, menu: t.menuLabel, closeText: t.closeLabel })}
    >
      <span data-menu-text aria-hidden="true">{t.menuLabel}</span>
      <span class="sr-only" data-menu-label>{t.menuOpen}</span>
      <span data-icon-open><Icon name="menu" class="size-[18px]" /></span>
      <span data-icon-close class="hidden"><Icon name="close" class="size-[18px]" /></span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label={t.mainNav}
    class="hidden h-[calc(100dvh-5.5rem)] overflow-y-auto bg-ivory xl:hidden"
    data-menu
  >
    <div class="container-site flex flex-col pt-12 pb-10">
      <ul>
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.key) ? 'page' : undefined}
                class:list={['flex min-h-20 items-center text-[1.75rem] leading-tight font-semibold', isCurrent(item.key) && 'underline decoration-azur decoration-2 underline-offset-8']}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ExternalLink href={settings.bookingsUrl} lang={lang} icon={false} track="menu-mobile" class="btn btn-primary mt-8 w-full">
        {t.book}
      </ExternalLink>
      <p class="mt-8 text-sm font-medium text-stone">{t.signature}</p>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (toggle && menu) {
    const html = document.documentElement;
    const label = toggle.querySelector('[data-menu-label]')!;
    const text = toggle.querySelector('[data-menu-text]')!;
    const labels = JSON.parse(toggle.dataset.labels!) as { open: string; close: string; menu: string; closeText: string };
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      html.classList.toggle('overflow-hidden', open);
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
      label.textContent = open ? labels.close : labels.open;
      text.textContent = open ? labels.closeText : labels.menu;
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 80rem)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
