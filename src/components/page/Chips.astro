---
/** Liste d'étiquettes (besoins, livrables). */
interface Props {
  label: string;
  items: string[];
}
const { label, items } = Astro.props;
---

<div class="flex flex-col gap-3">
  <p class="eyebrow">{label}</p>
  <ul class="flex flex-wrap gap-2">
    {items.map((item) => <li class="rounded-2xl border border-azur/60 bg-azur-mist px-3 py-1.5 text-sm leading-tight">{item}</li>)}
  </ul>
</div>
