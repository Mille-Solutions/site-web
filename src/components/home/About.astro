---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import ExternalLink from '../ExternalLink.astro';
import type { Lang } from '../../i18n/ui';
import { Image } from 'astro:assets';
import portraitImage from '../../assets/charlotte-charles-mille.jpeg';

interface Props {
  lang: Lang;
  content: CollectionEntry<'home'>['data']['about'];
  id: string;
  linkedinUrl: string;
}
const { lang, content, id, linkedinUrl } = Astro.props;
const [first, ...rest] = content.paragraphs;
---

<section id={id} aria-labelledby={`${id}-title`} class="section bg-ivory">
  <div class="container-site">
    <SectionHeading eyebrow={content.eyebrow} title={content.title} id={`${id}-title`} />
    <div class="mt-8 grid items-start gap-8 lg:mt-16 lg:grid-cols-[22.5rem_1fr]">
      <Image
        src={portraitImage}
        alt="Portrait de Charlotte Charles Mille"
        widths={[360, 720]}
        sizes="(min-width: 1024px) 360px, calc(100vw - 3rem)"
        loading="lazy"
        class="reveal aspect-[342/380] w-full rounded-(--radius-card) object-cover object-top lg:aspect-[360/480]"
      />
      <div class="flex flex-col items-start gap-8 sm:gap-6">
        {content.introTitle && <h3 class="text-xl leading-[1.3] font-medium sm:text-2xl sm:leading-[1.25] sm:font-semibold">{content.introTitle}</h3>}
        <p class="text-xl leading-[1.3] font-medium sm:text-2xl sm:leading-[1.25] sm:font-semibold lg:text-[2rem] lg:leading-[1.2]">{first}</p>
        {rest.map((p) => <p class="leading-6 text-stone sm:text-lg sm:leading-[1.6]">{p}</p>)}
        <!-- Phase 1 : LinkedIn ; phase 2 : page « Approche et parcours » -->
        <ExternalLink href={linkedinUrl} lang={lang} icon={false} class="btn btn-primary w-full sm:w-auto">
          {content.cta}
        </ExternalLink>
      </div>
    </div>
  </div>
</section>
