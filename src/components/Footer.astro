---
import Logo from './Logo.astro';
import { ui, routes, sections, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const s = sections[lang];
const home = routes.home[lang];
const navItems = [
  { label: t.home, href: home },
  { label: t.nav.services, href: `${home}#${s.services}` },
  { label: t.nav.approach, href: `${home}#${s.approach}` },
  { label: t.nav.examples, href: `${home}#${s.examples}` },
  { label: t.nav.contact, href: `${home}#${s.contact}` },
];
---

<footer class="bg-ivory">
  <div class="container-site pt-16 pb-10 lg:pt-24">
    <div class="h-px bg-azur" aria-hidden="true"></div>

    <div class="flex flex-col gap-12 pt-12 lg:flex-row lg:justify-between lg:pt-16">
      <div class="flex flex-col gap-6">
        <Logo size={24} />
        <p class="text-lg font-medium">{t.signature}</p>
      </div>

      <div class="flex flex-col gap-10 sm:flex-row sm:gap-20">
        <nav aria-labelledby="footer-nav">
          <p id="footer-nav" class="eyebrow">{t.footerNav}</p>
          <ul class="mt-5 space-y-1 text-sm">
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} class="inline-flex min-h-8 items-center hover:underline">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div>
          <p class="eyebrow">{t.footerContact}</p>
          <address class="mt-5 space-y-1 text-sm leading-relaxed not-italic">
            {t.footerContactLines.map((line) => <p>{line}</p>)}
          </address>
        </div>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 text-xs text-stone sm:flex-row sm:items-center sm:justify-between">
      <p class="tracking-wide uppercase">© {new Date().getFullYear()} Mille Solutions. {t.rights}</p>
      <nav aria-label={t.legalNav}>
        <ul class="flex gap-6">
          <li><a href={routes.legal[lang]} class="inline-flex min-h-8 items-center hover:text-navy hover:underline">{t.legal}</a></li>
          <li><a href={routes.privacy[lang]} class="inline-flex min-h-8 items-center hover:text-navy hover:underline">{t.privacy}</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
