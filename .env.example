# Variables d'environnement du conteneur (copier en .env, jamais commité).
# Envoi du formulaire de contact par la messagerie du domaine (SMASH), en SMTP authentifié.

# Serveur d'envoi (SMTP) : paramètres fournis par SMASH.
SMTP_HOST=smtp.exemple.mc
# 587 (STARTTLS, recommandé) ou 465 (TLS direct).
SMTP_PORT=587
# true pour le port 465 ; déduit du port si absent.
# SMTP_SECURE=false
SMTP_USER=formulaire@millesolutions.mc
SMTP_PASS=

# Expéditeur (la boîte ci-dessus en général) et destinataire des demandes.
MAIL_FROM=formulaire@millesolutions.mc
MAIL_TO=charlotte@millesolutions.mc

# true si le conteneur est derrière un proxy inverse (nginx, Traefik…) qui transmet
# X-Forwarded-For : la limite d'envois se fait alors sur l'adresse réelle du visiteur.
TRUST_PROXY=false
# Nombre d'envois autorisés par adresse IP et par quart d'heure.
# CONTACT_RATE_LIMIT=5

# Clé secrète du captcha ALTCHA (générer avec : openssl rand -hex 32).
# Facultative : sans elle, une clé aléatoire est tirée à chaque démarrage du conteneur.
ALTCHA_HMAC_KEY=
