---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/page/PageHero.astro';
import Statement from '../components/page/Statement.astro';
import CtaSection from '../components/page/CtaSection.astro';
import Chips from '../components/page/Chips.astro';
import CardSection from '../components/home/CardSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { routes } from '../i18n/ui';

const lang = 'fr';
const page = (await getEntry('services', lang))!.data;
const settings = (await getEntry('settings', 'links'))!.data;
const { list } = page;
---

<Base lang={lang} route="services" title={page.meta.title} description={page.meta.description}>
  <PageHero
    lang={lang}
    title={page.hero.title}
    lead={page.hero.lead}
    primary={page.hero.primary}
    secondary={page.hero.secondary ? { label: page.hero.secondary, href: routes.approach.fr } : undefined}
    bookingsUrl={settings.bookingsUrl}
    imageCaption={page.hero.imageCaption}
    track="services-hero"
  />

  <Statement text={page.statement} />

  <section aria-labelledby="liste-title" class="section bg-ivory">
    <div class="container-site">
      <SectionHeading eyebrow={list.eyebrow} title={list.title} id="liste-title" />
      <ul class="mt-8 grid items-start gap-4 lg:mt-20 lg:grid-cols-3 lg:gap-8">
        {
          list.items.map((item) => (
            <li id={item.id} class="reveal card flex scroll-mt-28 flex-col gap-8 lg:p-10">
              <div class="flex items-center gap-4">
                <span class="icon-badge size-14">
                  <Icon name={item.icon} class="size-6" />
                </span>
                <h3 class="text-xl leading-[1.3] font-semibold">{item.title}</h3>
              </div>
              <p class="leading-[1.6] text-stone">{item.text}</p>
              <Chips label={list.needsLabel} items={item.needs} />
              <div class="flex flex-col gap-3">
                <p class="eyebrow">{list.interventionLabel}</p>
                <p class="leading-[1.6]">{item.intervention}</p>
              </div>
              <Chips label={list.deliverablesLabel} items={item.deliverables} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CardSection id="approche" eyebrow={page.approach.eyebrow} title={page.approach.title} items={page.approach.items} tone="white" corner />

  <CtaSection lang={lang} {...page.cta} bookingsUrl={settings.bookingsUrl} track="services-cta" />
</Base>
