---
/** Bandeau de déclaration centré, encadré de deux filets Azure (« statement-band » de la maquette). */
interface Props {
  text: string;
  secondary?: string;
}
const { text, secondary } = Astro.props;
---

<section class="bg-ivory py-20 lg:py-30">
  <div class="container-site">
    <div class="mx-auto flex max-w-[53rem] flex-col items-center gap-10 text-center">
      <span aria-hidden="true" class="block h-px w-full bg-azur/60"></span>
      <div class="flex flex-col gap-4">
        <p class="text-[2.25rem] leading-[1.15] font-semibold text-balance lg:text-[4rem]">{text}</p>
        {secondary && <p class="text-[1.75rem] leading-[1.2] font-medium text-balance text-stone lg:text-[3rem]">{secondary}</p>}
      </div>
      <span aria-hidden="true" class="block h-px w-full bg-azur/60"></span>
    </div>
  </div>
</section>
