---
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';

interface Props {
  content: CollectionEntry<'home'>['data']['method'];
  id: string;
}
const { content, id } = Astro.props;
const last = content.steps.length - 1;
---

<section id={id} aria-labelledby={`${id}-title`} class="on-navy bg-navy py-20 text-ivory sm:py-28">
  <div class="container-site">
    <SectionHeading number="03." eyebrow={content.eyebrow} title={content.title} id={`${id}-title`} tone="ivory" />

    <!-- Ligne de progression : la méthode Mille Solutions -->
    <ol class="relative grid gap-10 md:grid-cols-3 md:gap-8">
      <span aria-hidden="true" class="absolute top-[7px] right-[16%] left-[7px] hidden h-px bg-azur md:block"></span>
      <span aria-hidden="true" class="absolute top-2 bottom-2 left-[7px] w-px bg-azur md:hidden"></span>
      {
        content.steps.map((step, i) => (
          <li class="reveal relative pl-10 md:pl-0">
            <span
              aria-hidden="true"
              class:list={[
                'absolute top-0 left-0 block size-[15px] rounded-full border-2 md:relative',
                i === last ? 'border-azur bg-azur' : 'border-ivory bg-navy',
              ]}
            />
            <p class="text-sm text-ivory/60 md:mt-8">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-2 text-2xl font-semibold">{step.title}</h3>
            <p class="mt-3 max-w-xs leading-relaxed text-ivory/80">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <blockquote class="mt-20 max-w-3xl border-l border-azur pl-6 sm:mt-24">
      <p class="text-2xl leading-snug font-light text-balance sm:text-3xl">{content.quote}</p>
    </blockquote>
  </div>
</section>
