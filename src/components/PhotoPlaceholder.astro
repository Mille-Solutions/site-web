---
/**
 * Emplacement photo provisoire, en attendant les images fournies par Charlotte (droits à valider).
 * Remplacer par <Image> d'astro:assets — voir docs/GUIDE.md.
 */
interface Props {
  caption: string;
  class?: string;
}
const { caption, class: className = '' } = Astro.props;
---

<figure class:list={['relative flex items-center justify-center overflow-hidden rounded-(--radius-card) bg-mist', className]}>
  <figcaption class="max-w-xs px-6 text-center text-sm text-stone">{caption}</figcaption>
</figure>
