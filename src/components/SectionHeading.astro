---
/** En-tête de section du site : repère (Inter SemiBold 14, Stone) puis titre H2. */
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
  class?: string;
}
const { eyebrow, title, id, class: className = '' } = Astro.props;
---

<div class:list={['flex flex-col gap-4', className]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="h2">{title}</h2>
</div>
