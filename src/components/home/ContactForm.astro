---
/**
 * Formulaire de contact (maquette « Accueil — FR » et « États du formulaire »).
 * Nom, adresse e-mail et message obligatoires ; organisation facultative ; aucune pièce jointe.
 *
 * L'envoi est délégué au service ou script côté serveur défini dans settings.yaml
 * (contactFormEndpoint). Ce service doit valider les champs, filtrer les robots, limiter les envois
 * et garder l'adresse destinataire secrète. Tant qu'aucune adresse n'est définie, le formulaire
 * reste visible mais désactivé.
 */
import type { CollectionEntry } from 'astro:content';
import { routes, ui, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  content: CollectionEntry<'home'>['data']['contact']['form'];
  endpoint: string;
}
const { lang, content: f, endpoint } = Astro.props;
const t = ui[lang];
const enabled = endpoint.trim() !== '';

const fields = [
  { name: 'name', label: f.name, placeholder: f.namePlaceholder, type: 'text', required: true, autocomplete: 'name', maxlength: 120 },
  { name: 'email', label: f.email, placeholder: f.emailPlaceholder, type: 'email', required: true, autocomplete: 'email', maxlength: 254 },
  { name: 'organisation', label: f.organisation, placeholder: f.organisationPlaceholder, type: 'text', required: false, autocomplete: 'organization', maxlength: 160 },
] as const;
const inputClass =
  'w-full border border-stone/50 bg-white px-4 py-4 text-base text-navy placeholder:text-stone/80 aria-invalid:border-[#b42318] disabled:cursor-not-allowed disabled:bg-ivory';
---

<form
  class="card relative flex flex-col gap-6"
  action={enabled ? endpoint : undefined}
  method="post"
  novalidate
  data-contact-form
  data-messages={JSON.stringify({ success: f.success, error: f.error, invalid: f.invalid, sending: f.sending, submit: f.submit, required: t.fieldRequired, email: t.fieldEmail })}
>
  <p class="eyebrow">{f.eyebrow}</p>

  {
    !enabled && (
      <p class="border-l-2 border-azur bg-azur-mist px-4 py-3 text-sm leading-relaxed" data-unavailable>
        {f.unavailable}
      </p>
    )
  }

  <fieldset class="flex flex-col gap-6" disabled={!enabled}>
    <legend class="sr-only">{f.eyebrow}</legend>
    {
      fields.map((field) => (
        <div class="flex flex-col gap-2">
          <label for={`contact-${field.name}`} class="text-sm font-semibold">
            {field.label}
            {field.required && (
              <span aria-hidden="true"> *</span>
            )}
          </label>
          <input
            id={`contact-${field.name}`}
            name={field.name}
            type={field.type}
            placeholder={field.placeholder}
            required={field.required}
            autocomplete={field.autocomplete}
            maxlength={field.maxlength}
            aria-describedby={`contact-${field.name}-error`}
            class={inputClass}
          />
          <p id={`contact-${field.name}-error`} class="hidden text-sm text-[#b42318]" data-error />
        </div>
      ))
    }
    <div class="flex flex-col gap-2">
      <label for="contact-message" class="text-sm font-semibold">
        {f.message}
        <span aria-hidden="true"> *</span>
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="6"
        required
        minlength="10"
        maxlength="5000"
        placeholder={f.messagePlaceholder}
        aria-describedby="contact-message-error"
        class={`${inputClass} min-h-40 resize-y`}></textarea>
      <p id="contact-message-error" class="hidden text-sm text-[#b42318]" data-error></p>
    </div>

    <!-- Piège à robots : champ invisible que seuls les robots remplissent -->
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for="contact-website">Website</label>
      <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="lang" value={lang} />

    <button type="submit" class="btn btn-primary w-full disabled:cursor-not-allowed disabled:opacity-60" data-submit>
      {f.submit}
    </button>
  </fieldset>

  <p role="status" aria-live="polite" class="hidden border-l-2 px-4 py-3 text-sm leading-relaxed" data-status></p>

  <p class="text-sm leading-relaxed text-stone">
    {f.notice} <a href={routes.privacy[lang]} class="link-underline text-navy">{f.noticeLink}</a>. {f.requiredNote}
  </p>
</form>

<script>
  type Messages = Record<'success' | 'error' | 'invalid' | 'sending' | 'submit' | 'required' | 'email', string>;

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-contact-form]')) {
    const messages = JSON.parse(form.dataset.messages!) as Messages;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const controls = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([type=hidden]):not([name=website]), textarea')];

    const showStatus = (text: string, kind: 'success' | 'error') => {
      status.textContent = text;
      status.classList.remove('hidden', 'border-azur', 'bg-azur-mist', 'border-[#b42318]', 'bg-[#fef3f2]');
      status.classList.add(...(kind === 'success' ? ['border-azur', 'bg-azur-mist'] : ['border-[#b42318]', 'bg-[#fef3f2]']));
    };

    const validate = (el: HTMLInputElement | HTMLTextAreaElement) => {
      const error = el.parentElement!.querySelector<HTMLElement>('[data-error]')!;
      el.value = el.value.trimStart();
      let message = '';
      if (el.validity.valueMissing || el.validity.tooShort) message = messages.required;
      else if (el.validity.typeMismatch) message = messages.email;
      if (message) el.setAttribute('aria-invalid', 'true');
      else el.removeAttribute('aria-invalid');
      error.textContent = message;
      error.classList.toggle('hidden', message === '');
      return message === '';
    };

    controls.forEach((el) => el.addEventListener('blur', () => el.hasAttribute('aria-invalid') && validate(el)));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.action) return;

      const invalid = controls.filter((el) => !validate(el));
      if (invalid.length) {
        showStatus(messages.invalid, 'error');
        invalid[0].focus();
        return;
      }

      submit.disabled = true;
      submit.textContent = messages.sending;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(String(response.status));
        form.reset();
        showStatus(messages.success, 'success');
        // Statistiques : seuls les envois réussis sont comptés, sans aucun contenu du message.
        form.dispatchEvent(new CustomEvent('contact:sent', { bubbles: true }));
      } catch {
        // La saisie est conservée : on ne réinitialise pas le formulaire.
        showStatus(messages.error, 'error');
      } finally {
        submit.disabled = false;
        submit.textContent = messages.submit;
      }
    });
  }
</script>
