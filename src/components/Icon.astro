---
/**
 * Icônes de la charte 2026 (Figma « 07b — Iconographie ») : grille 24 × 24 px, trait 1,75 px,
 * extrémités arrondies, sans remplissage. Coordination, Structuration, Priorisation, Solutions et Résultats reprennent
 * les tracés Figma ; Collaboration est redessinée dans le même style (tracé à faire valider).
 */
interface Props {
  name: 'coordination' | 'structuration' | 'priorisation' | 'solutions' | 'collaboration' | 'resultats' | 'arrow' | 'external' | 'menu' | 'close';
  class?: string;
}
const { name, class: className = 'size-6' } = Astro.props;
const ui = ['arrow', 'external', 'menu', 'close'].includes(name);
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={ui ? 1.5 : 1.75}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'coordination' && (
      <>
        <circle cx="12.42" cy="4.92" r="2.08" />
        <circle cx="4.08" cy="19.08" r="2.08" />
        <circle cx="19.92" cy="19.08" r="2.08" />
        <path d="M7 16.17 11.86 8.39M13.67 7.83l4.85 7.78M7 19.08h10.83" />
      </>
    )
  }
  {
    name === 'structuration' && (
      <>
        <rect x="3" y="3" width="7.71" height="7.71" rx="1.71" />
        <rect x="13.29" y="3" width="7.71" height="7.71" rx="1.71" />
        <rect x="3" y="13.29" width="7.71" height="7.71" rx="1.71" />
        <rect x="13.29" y="13.29" width="7.71" height="7.71" rx="1.71" />
      </>
    )
  }
  {
    name === 'priorisation' && (
      <>
        <circle cx="3.2" cy="6" r="1.8" />
        <circle cx="8.4" cy="12" r="1.8" />
        <circle cx="3.2" cy="18" r="1.8" />
        <path d="M7.6 6h12.8M12.4 12H22M7.6 18h12.8" />
      </>
    )
  }
  {
    name === 'solutions' && (
      <>
        <circle cx="12" cy="12" r="4.91" />
        <circle cx="12" cy="12" r="1.64" />
        <path d="M18.55 12.00L21.00 12.00M16.63 16.63L18.36 18.36M12.00 18.55L12.00 21.00M7.37 16.63L5.64 18.36M5.46 12.00L3.00 12.00M7.37 7.37L5.64 5.64M12.00 5.46L12.00 3.00M16.63 7.37L18.36 5.64" />
      </>
    )
  }
  {
    name === 'collaboration' && (
      <>
        <circle cx="8" cy="7.5" r="3" />
        <circle cx="16.5" cy="9" r="2.5" />
        <path d="M2.75 19.5c0-3.04 2.35-5.5 5.25-5.5s5.25 2.46 5.25 5.5" />
        <path d="M14.5 14.4c.62-.26 1.3-.4 2-.4 2.62 0 4.75 2.24 4.75 5" />
      </>
    )
  }
  {
    name === 'resultats' && (
      <>
        <circle cx="12.43" cy="11.57" r="9.57" />
        <circle cx="12.43" cy="11.57" r="5.22" />
        <path d="M2 22 9.38 14.62M6.24 12.76l3.69 3.69" />
      </>
    )
  }
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {
    name === 'external' && (
      <>
        <path d="M14 4h6v6" />
        <path d="M20 4 11 13" />
        <path d="M18 14v4.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10" />
      </>
    )
  }
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
</svg>
