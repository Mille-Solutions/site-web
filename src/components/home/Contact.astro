---
/**
 * Bandeau Contact : titre, texte, puis
 * - sur l'accueil : encart renvoyant vers le formulaire (page Contact, ou Microsoft Forms tant que
 *   le service d'envoi n'est pas configuré) ;
 * - sur la page Contact : le formulaire lui-même, passé en contenu (slot).
 */
import ExternalLink from '../ExternalLink.astro';
import { routes, type Lang } from '../../i18n/ui';

interface Content {
  eyebrow?: string;
  title: string;
  text: string;
  form?: { eyebrow: string; intro?: string; cta: string; notice: string; noticeLink: string; requiredNote: string };
}

interface Props {
  lang: Lang;
  content: Content;
  id: string;
  /** Destination du bouton de l'encart (accueil). */
  formHref?: string;
  /** true si formHref est un site externe (Microsoft Forms). */
  formExternal?: boolean;
  /** h1 sur la page Contact, h2 sur l'accueil. */
  headingLevel?: 'h1' | 'h2';
  /** « dark » : fond Navy des maquettes « Accueil — FR » et « Contact — FR » ; « light » : fond blanc. */
  tone?: 'dark' | 'light';
}
const { lang, content, id, formHref, formExternal = false, headingLevel = 'h2', tone = 'light' } = Astro.props;
const Heading = headingLevel;
const dark = tone === 'dark';
const hasForm = Astro.slots.has('default');
const card = content.form;
---

<section id={id} aria-labelledby={`${id}-title`} class:list={['section', dark ? 'bg-navy text-ivory' : 'bg-white']}>
  <div class="container-site">
    {content.eyebrow && <p class:list={['eyebrow mb-4', dark ? 'text-ivory/75' : 'text-stone']}>{content.eyebrow}</p>}
    <Heading id={`${id}-title`} class="text-[2rem] leading-[1.25] font-semibold text-balance sm:text-[2.5rem] sm:leading-[1.1] lg:text-[5rem]">{content.title}</Heading>
    <!-- Maquette : Stone sur Navy ; éclairci ici pour atteindre le contraste AA (4,5:1). -->
    <p class:list={['mt-8 max-w-[53rem] leading-6 sm:mt-6 sm:text-lg sm:leading-[1.6]', dark ? 'text-ivory/75' : 'text-stone']}>{content.text}</p>

    <div class="mt-8 max-w-[45.8125rem] lg:mt-16">
      {
        hasForm ? (
          <slot />
        ) : (
          card &&
          formHref && (
            <div class:list={['card flex flex-col gap-5 text-navy', dark && 'border-0']}>
              {card.eyebrow && <p class="eyebrow">{card.eyebrow}</p>}
              {card.intro && <p class="leading-6 text-stone">{card.intro}</p>}
              {formExternal ? (
                <ExternalLink href={formHref} lang={lang} icon={false} track="contact-form" class="btn btn-primary w-full sm:w-auto">
                  {card.cta}
                </ExternalLink>
              ) : (
                <a href={formHref} class="btn btn-primary w-full sm:w-auto" data-track="contact-page">
                  {card.cta}
                </a>
              )}
              <p class="text-sm leading-relaxed text-stone">
                {card.notice}
                <a href={routes.privacy[lang]} class="link-underline text-navy"> {card.noticeLink}</a>.
                {lang === 'fr' && card.requiredNote && <span> {card.requiredNote}</span>}
              </p>
            </div>
          )
        )
      }
    </div>
  </div>
</section>
