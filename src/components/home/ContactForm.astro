---
/**
 * Formulaire de la page Contact (champs repris du formulaire Microsoft Forms « Contactez-moi »).
 * Obligatoires : nom et prénom, adresse e-mail, demande. Téléphone obligatoire si le mode de
 * contact préféré est WhatsApp ou téléphone. Aucune pièce jointe.
 *
 * Envoi : POST vers contactFormEndpoint (settings.yaml), par défaut /api/contact/
 * (src/pages/api/contact.ts), qui contrôle à nouveau les champs et envoie l'e-mail par SMTP.
 * Sans adresse d'envoi (ou CONTACT_FORM=off à la construction), le formulaire reste visible mais
 * désactivé.
 */
import type { CollectionEntry } from 'astro:content';
import { routes, ui, url, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  content: CollectionEntry<'contactPage'>['data']['form'];
  endpoint: string;
  /** Filet Azure autour de la carte (fond clair) ; sans filet sur fond Navy. */
  bordered?: boolean;
}
const { lang, content: f, endpoint, bordered = true } = Astro.props;
const t = ui[lang];
const enabled = endpoint.trim() !== '';

type Field = {
  name: string;
  label: string;
  hint: string;
  type: 'text' | 'email' | 'tel';
  required?: boolean;
  autocomplete: string;
  maxlength: number;
  pattern?: string;
  inputmode?: 'url';
};
const field = (name: string, label: string, hint: string, rest: Omit<Field, 'name' | 'label' | 'hint'>): Field => ({ name, label, hint, ...rest });

const before: Field[] = [
  field('name', f.name, f.nameHint, { type: 'text', required: true, autocomplete: 'name', maxlength: 120 }),
  field('organisation', f.organisation, f.organisationHint, { type: 'text', autocomplete: 'organization', maxlength: 160 }),
  field('position', f.position, f.positionHint, { type: 'text', autocomplete: 'organization-title', maxlength: 120 }),
  field('phone', f.phone, f.phoneHint, { type: 'tel', autocomplete: 'tel', maxlength: 30, pattern: '\\+?[0-9][0-9 \\(\\)\\.\\-]{5,24}' }),
  field('email', f.email, f.emailHint, { type: 'email', required: true, autocomplete: 'email', maxlength: 254 }),
];
const site = field('site', f.site, f.siteHint, {
  type: 'text',
  inputmode: 'url',
  autocomplete: 'url',
  maxlength: 300,
  pattern: '(https?:\\/\\/)?[^\\s\\/]+\\.[^\\s]{2,}',
});
const methods = [
  { value: f.contactMethods.whatsapp, phone: true },
  { value: f.contactMethods.phone, phone: true },
  { value: f.contactMethods.email, phone: false },
];

const inputClass =
  'w-full rounded-lg border border-azur bg-white px-4 py-4 text-base text-navy placeholder:text-stone aria-invalid:border-[#b42318] disabled:cursor-not-allowed disabled:bg-ivory';
const messages = {
  success: f.success,
  error: f.error,
  invalid: f.invalid,
  sending: f.sending,
  submit: f.submit,
  required: t.fieldRequired,
  email: t.fieldEmail,
  url: t.fieldUrl,
  phoneRequired: f.phoneRequired,
  phoneInvalid: f.phoneInvalid,
  captcha: f.captchaError,
};
// Captcha ALTCHA : défi fourni par le serveur du site (src/pages/api/altcha.ts), aucun service tiers.
const altchaConfig = JSON.stringify({ hideLogo: true, hideFooter: true, humanInteractionSignature: false });
---

<form
  class:list={['card relative flex flex-col gap-6 text-navy', !bordered && 'border-0']}
  action={enabled ? endpoint : undefined}
  method="post"
  novalidate
  data-contact-form
  data-messages={JSON.stringify(messages)}
>
  <p class="eyebrow">{f.eyebrow}</p>

  {
    !enabled && (
      <p class="border-l-2 border-azur bg-azur-mist px-4 py-3 text-sm leading-relaxed" data-unavailable>
        {f.unavailable}
      </p>
    )
  }

  <fieldset class="flex flex-col gap-6" disabled={!enabled}>
    <legend class="sr-only">{f.eyebrow}</legend>

    {
      before.map((x) => (
        <div class="flex flex-col gap-2">
          <label for={`contact-${x.name}`} class="text-sm font-semibold">
            {x.label}
            {x.required ? <span aria-hidden="true"> *</span> : <span aria-hidden="true" data-phone-star class="hidden"> *</span>}
          </label>
          <p id={`contact-${x.name}-hint`} class="-mt-1 text-sm leading-relaxed text-stone">{x.hint}</p>
          <input
            id={`contact-${x.name}`}
            name={x.name}
            type={x.type}
            required={x.required}
            autocomplete={x.autocomplete}
            maxlength={x.maxlength}
            pattern={x.pattern}
            aria-describedby={`contact-${x.name}-hint contact-${x.name}-error`}
            class={inputClass}
          />
          <p id={`contact-${x.name}-error`} class="hidden text-sm text-[#b42318]" data-error />
        </div>
      ))
    }

    <fieldset class="flex flex-col gap-2">
      <legend class="mb-2 text-sm font-semibold">{f.contactMethod}</legend>
      {
        methods.map((m, i) => (
          <label class="flex min-h-11 cursor-pointer items-center gap-3">
            <input
              type="radio"
              name="contactMethod"
              value={m.value}
              data-needs-phone={m.phone ? '' : undefined}
              class="size-5 shrink-0 accent-navy"
              id={`contact-method-${i}`}
            />
            <span>{m.value}</span>
          </label>
        ))
      }
    </fieldset>

    <div class="flex flex-col gap-2">
      <label for="contact-site" class="text-sm font-semibold">{site.label}</label>
      <p id="contact-site-hint" class="-mt-1 text-sm leading-relaxed text-stone">{site.hint}</p>
      <input
        id="contact-site"
        name="site"
        type="text"
        inputmode="url"
        autocomplete="url"
        maxlength={site.maxlength}
        pattern={site.pattern}
        aria-describedby="contact-site-hint contact-site-error"
        class={inputClass}
      />
      <p id="contact-site-error" class="hidden text-sm text-[#b42318]" data-error></p>
    </div>

    <div class="flex flex-col gap-2">
      <label for="contact-message" class="text-sm font-semibold">
        {f.message}
        <span aria-hidden="true"> *</span>
      </label>
      <p id="contact-message-hint" class="-mt-1 text-sm leading-relaxed text-stone">{f.messageHint}</p>
      <textarea
        id="contact-message"
        name="message"
        rows="6"
        required
        minlength="10"
        maxlength="5000"
        aria-describedby="contact-message-hint contact-message-error"
        class={`${inputClass} min-h-40 resize-y`}></textarea>
      <p id="contact-message-error" class="hidden text-sm text-[#b42318]" data-error></p>
    </div>

    <!-- Piège à robots : case invisible que seuls les robots cochent (rejetée par le serveur). -->
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for="contact-botcheck">Ne pas cocher</label>
      <input id="contact-botcheck" name="botcheck" type="checkbox" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="lang" value={lang} />

    {
      enabled && (
        <altcha-widget
          challenge={url('/api/altcha/')}
          language={lang === 'fr' ? 'fr-fr' : 'en'}
          type="checkbox"
          auto="off"
          name="altcha"
          configuration={altchaConfig}
          data-altcha
        />
      )
    }

    <button type="submit" class="btn btn-dark w-full disabled:cursor-not-allowed disabled:opacity-60" data-submit>
      {f.submit}
    </button>
  </fieldset>

  <p role="status" aria-live="polite" class="hidden border-l-2 px-4 py-3 text-sm leading-relaxed" data-status></p>

  <div class="text-sm leading-relaxed text-stone">
    <p class="font-semibold text-navy">{f.privacyTitle}</p>
    <p class="mt-1">
      {f.notice} <a href={routes.privacy[lang]} class="link-underline text-navy">{f.noticeLink}</a>. {f.requiredNote}
    </p>
  </div>
</form>

<script>
  import 'altcha';
  import 'altcha/i18n/fr-fr';
  import 'altcha/i18n/en';

  type Messages = Record<
    'success' | 'error' | 'invalid' | 'sending' | 'submit' | 'required' | 'email' | 'url' | 'phoneRequired' | 'phoneInvalid' | 'captcha',
    string
  >;
  type Control = HTMLInputElement | HTMLTextAreaElement;
  type AltchaState = 'unverified' | 'verifying' | 'verified' | 'error' | 'expired' | 'code';
  type AltchaWidget = HTMLElement & { getState(): AltchaState; verify(): unknown; reset(): void };

  /**
   * Lance (si besoin) la preuve de travail ALTCHA et renvoie la solution, ou null en cas d'échec.
   * Une seule vérification à la fois (voir startAltcha) : deux appels simultanés bloquent le composant.
   */
  function solveAltcha(widget: AltchaWidget, latest: { payload: string | null }): Promise<string | null> {
    if (widget.getState?.() === 'verified' && latest.payload) return Promise.resolve(latest.payload);
    return new Promise((resolve) => {
      const timer = setTimeout(() => finish(null), 60_000);
      // La solution arrive avec l'événement « verified » (après le changement d'état).
      const onVerified = (event: Event) => finish((event as CustomEvent<{ payload: string }>).detail?.payload ?? null);
      const onChange = (event: Event) => {
        const state = (event as CustomEvent<{ state: AltchaState }>).detail?.state;
        if (state === 'error' || state === 'expired') finish(null);
      };
      function finish(value: string | null) {
        clearTimeout(timer);
        widget.removeEventListener('statechange', onChange);
        widget.removeEventListener('verified', onVerified);
        resolve(value);
      }
      widget.addEventListener('statechange', onChange);
      widget.addEventListener('verified', onVerified);
      if (widget.getState?.() !== 'verifying') widget.verify();
    });
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-contact-form]')) {
    const messages = JSON.parse(form.dataset.messages!) as Messages;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const phone = form.querySelector<HTMLInputElement>('input[name=phone]')!;
    const phoneStar = phone.closest('div')!.querySelector<HTMLElement>('[data-phone-star]');
    const widget = form.querySelector<AltchaWidget>('[data-altcha]');
    // Dernière solution ALTCHA (événement « verified ») : jointe explicitement à l'envoi.
    const altcha = { payload: null as string | null };
    widget?.addEventListener('verified', (event) => {
      altcha.payload = (event as CustomEvent<{ payload: string }>).detail?.payload ?? null;
    });
    let pending: Promise<string | null> | null = null;
    // Le calcul démarre dès que le visiteur entre dans le formulaire : il est en général terminé
    // au moment de l'envoi. Une seule vérification en cours à la fois.
    const startAltcha = (): Promise<string | null> => {
      if (!widget) return Promise.resolve(null);
      pending ??= solveAltcha(widget, altcha).then((payload) => {
        if (!payload) pending = null;
        return payload;
      });
      return pending;
    };
    widget?.addEventListener('expired', () => {
      altcha.payload = null;
      pending = null;
    });
    form.addEventListener('focusin', () => void startAltcha());
    const resetAltcha = () => {
      altcha.payload = null;
      pending = null;
      widget?.reset();
    };
    const controls = [
      ...form.querySelectorAll<Control>('input:not([type=hidden]):not([type=radio]):not([type=checkbox]), textarea'),
    ];

    // WhatsApp ou téléphone choisi → numéro obligatoire.
    const syncPhone = () => {
      const needed = !!form.querySelector('input[name=contactMethod]:checked[data-needs-phone]');
      phone.required = needed;
      phoneStar?.classList.toggle('hidden', !needed);
      if (phone.hasAttribute('aria-invalid')) validate(phone);
    };
    form.querySelectorAll('input[name=contactMethod]').forEach((radio) => radio.addEventListener('change', syncPhone));

    const showStatus = (text: string, kind: 'success' | 'error') => {
      status.textContent = text;
      status.classList.remove('hidden', 'border-azur', 'bg-azur-mist', 'border-[#b42318]', 'bg-[#fef3f2]');
      status.classList.add(...(kind === 'success' ? ['border-azur', 'bg-azur-mist'] : ['border-[#b42318]', 'bg-[#fef3f2]']));
    };

    const errorFor = (el: Control): string => {
      const v = el.validity;
      if (v.valueMissing || v.tooShort) return el === phone ? messages.phoneRequired : messages.required;
      if (v.typeMismatch) return messages.email;
      if (v.patternMismatch) return el === phone ? messages.phoneInvalid : messages.url;
      return '';
    };

    function validate(el: Control) {
      const error = el.parentElement!.querySelector<HTMLElement>('[data-error]')!;
      el.value = el.value.trim();
      const message = errorFor(el);
      if (message) el.setAttribute('aria-invalid', 'true');
      else el.removeAttribute('aria-invalid');
      error.textContent = message;
      error.classList.toggle('hidden', message === '');
      return message === '';
    }

    controls.forEach((el) => el.addEventListener('blur', () => el.hasAttribute('aria-invalid') && validate(el)));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.action) return;

      const invalid = controls.filter((el) => !validate(el));
      if (invalid.length) {
        // Champ obligatoire manquant → message général ; sinon, le message du premier champ en cause.
        const missing = invalid.some((el) => el !== phone && (el.validity.valueMissing || el.validity.tooShort));
        showStatus(missing ? messages.invalid : errorFor(invalid[0]), 'error');
        invalid[0].focus();
        return;
      }

      submit.disabled = true;
      submit.textContent = messages.sending;
      try {
        const data = new FormData(form);
        // Robot détecté : on simule un succès sans rien envoyer.
        if (!data.get('botcheck')) {
          if (widget) {
            const payload = await startAltcha();
            if (!payload) throw new Error('captcha');
            data.set('altcha', payload);
          }
          const response = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
          if (!response.ok) {
            const body = (await response.json().catch(() => ({}))) as { error?: string };
            throw new Error(body.error === 'captcha' ? 'captcha' : String(response.status));
          }
        }
        form.reset();
        syncPhone();
        resetAltcha();
        showStatus(messages.success, 'success');
        // Statistiques : seuls les envois réussis sont comptés, sans aucun contenu du message.
        form.dispatchEvent(new CustomEvent('contact:sent', { bubbles: true }));
      } catch (error) {
        // La saisie est conservée : on ne réinitialise pas le formulaire. Une solution ALTCHA ne
        // sert qu'une fois : nouvelle vérification au prochain essai.
        resetAltcha();
        showStatus(error instanceof Error && error.message === 'captcha' ? messages.captcha : messages.error, 'error');
      } finally {
        submit.disabled = false;
        submit.textContent = messages.submit;
      }
    });
  }
</script>
