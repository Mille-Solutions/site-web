---
import type { CollectionEntry } from 'astro:content';
import ExternalLink from '../ExternalLink.astro';
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  content: CollectionEntry<'home'>['data']['hero'];
  bookingsUrl: string;
  servicesId: string;
}
const { lang, content, bookingsUrl, servicesId } = Astro.props;
---

<section class="bg-ivory pt-14 pb-16 lg:pt-24 lg:pb-24">
  <div class="container-site">
    <div class="max-w-[53rem]">
      <h1 class="h1">{content.title}</h1>
      <p class="mt-8 text-lg leading-[1.6] lg:text-xl">{content.lead}</p>

      <div class="mt-8">
        <p class="eyebrow">{content.engagementLabel}</p>
        <p class="mt-3 text-xl leading-[1.35] font-medium lg:text-[1.75rem]">{content.signature}</p>
      </div>

      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
        <ExternalLink href={bookingsUrl} lang={lang} icon={false} track="hero" class="btn btn-primary">
          {content.cta}
        </ExternalLink>
        <a href={`#${servicesId}`} class="btn btn-secondary">{content.secondary}</a>
      </div>
    </div>

    <PhotoPlaceholder caption={content.imageCaption} class="mt-8 aspect-[342/240] w-full lg:mt-14 lg:aspect-[1280/520]" />
  </div>
</section>
